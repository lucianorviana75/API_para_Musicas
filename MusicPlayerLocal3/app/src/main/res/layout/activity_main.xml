<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/capaAlbum"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="centerCrop"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/nomeMusica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome da Música"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="0"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:weightSum="2">

        <TextView
            android:id="@+id/tempoAtual"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"/>

        <TextView
            android:id="@+id/tempoTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:gravity="end"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <Button
            android:id="@+id/botaoPrev"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="⏮"
            android:textSize="20sp"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/botaoPlay"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="▶"
            android:textSize="20sp"
            android:layout_margin="4dp"
            android:backgroundTint="#4CAF50"/>

        <Button
            android:id="@+id/botaoPause"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="⏸"
            android:textSize="20sp"
            android:layout_margin="4dp"
            android:backgroundTint="#FFC107"/>

        <Button
            android:id="@+id/botaoStop"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="⏹"
            android:textSize="20sp"
            android:layout_margin="4dp"
            android:backgroundTint="#F44336"/>

        <Button
            android:id="@+id/botaoNext"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="⏭"
            android:textSize="20sp"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/botaoDelete"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="🗑"
            android:textSize="20sp"
            android:layout_margin="4dp"/>
    </LinearLayout>

    <ListView
        android:id="@+id/listaMusicas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:choiceMode="singleChoice"/>
</LinearLayout>